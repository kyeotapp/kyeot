 {
  "id": "revenue",
  "title": "수익",
  "bundle": "revenue",
  "shape": "`month{total,prev}`, `daily[{label,value}]`, `bySource[{label,value}]`",
  "spec": {
   "version": 1,
   "id": "revenue",
   "title": "수익",
   "icon": "chart.line.uptrend.xyaxis",
