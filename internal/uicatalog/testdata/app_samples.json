    {
     "type": "stats",
     "items": [
      {
       "label": "오늘 쓴 비용",
       "value": {
        "$data": "deck.costs.today"
       },
       "unit": "USD",
       "link": {
        "to": "costs",
        "period": "day"
       }
      },
      {
       "label": "최근 7일",
       "value": {
        "$data": "deck.costs.week"
       },
       "unit": "USD",
       "link": {
        "to": "costs",
        "period": "week"
       }
      }
     ]
    },
    {
     "type": "stats",
     "items": [
      {
       "label": "확인 요청",
       "value": {
        "$data": "deck.approvals.count"
       },
       "link": {
        "to": "approvals"
       }
      },
      {
       "label": "오늘 대화",
       "value": {
        "$data": "deck.tasks.today"
       }
      }
     ]
    },
    {
     "type": "bars",
     "title": "최근 7일 비용",
     "unit": "USD",
     "items": {
      "$data": "deck.costs.daily"
     },
     "link": {
      "to": "costs",
      "period": "week"
     }
    },
    {
     "type": "list",
     "title": "다음 루틴",
     "items": {
      "$data": "deck.routines.upcoming"
     },
     "link": {
      "to": "routines"
     }
    }
   ]
  },
  {
   "version": 1,
   "id": "revenue",
   "title": "수익",
   "icon": "chart.line.uptrend.xyaxis",
   "blocks": [
    {
     "type": "stat",
     "label": "이번 달",
     "value": {
      "$data": "revenue.month.total"
     },
     "unit": "KRW",
     "compare": {
      "$data": "revenue.month.prev"
     },
     "compareLabel": "지난달",
     "better": "up"
    },
    {
     "type": "bars",
     "title": "하루씩",
     "unit": "KRW",
     "items": {
      "$data": "revenue.daily"
     }
    },
    {
     "type": "hbars",
     "title": "어디서 벌었나",
     "unit": "KRW",
     "items": {
      "$data": "revenue.bySource"
     }
    },
    {
     "type": "button",
     "label": "에이전트에게 채워 달라고 하기",
     "say": "수익 탭에 내 수익 데이터를 채워 줘. 어디서 가져올지 먼저 물어봐 줘"
    }
   ]
  },
